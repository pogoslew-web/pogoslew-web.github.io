---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import { entities, codes } from '../../lib/db';
import { renderHtml } from '../../lib/links';
export function getStaticPaths() { return entities.filter(e => e.type === 'news' && e.slug !== 'index').map(e => ({ params: { id: e.slug }, props: { id: e.id } })); }
const e = entities.find(x => x.id === Astro.props.id)!;
const bl = e.sections.flatMap(s => s.blocks).filter(b => b.type !== 'nav' && b.type !== 'h1');
const date = bl.find(b => b.type === 'div' && /20\d\d/.test(b.text ?? ''))?.text ?? null;
const code = codes.find(c => c.news_id === e.id);
const html = bl.map(b => renderHtml(b.html ?? '')).join('\n');
---
<Base title={e.title} description={(bl.find(b => b.type === 'p')?.text ?? e.title).slice(0, 170)}>
  <div class="wrap page" style="max-width:820px">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Announcements', href: '/news/' }, { label: e.title }]} />
    <header class="page-head"><h1>{e.title}</h1>{date && <p>{date.replace(/·.*$/, '').trim()}</p>}</header>
    <article class="card" style="padding:24px"><div class="prose" set:html={html} /></article>
    <div class="page-actions" style="margin-top:16px">
      {code && <a class="btn btn-primary" href="/codes/">See all codes</a>}
      <a class="btn" href={e.source.url} target="_blank" rel="noopener noreferrer"><Icon name="external" size={14} /> Original post</a>
    </div>
  </div>
</Base>
