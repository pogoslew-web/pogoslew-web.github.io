---
import type { ClassCard } from '../lib/db';
interface Props { card: ClassCard; title: string }
const { card, title } = Astro.props;
const neg = (s: string) => s.trim().startsWith('-');
---
<section class="card class-card" id="class-card" aria-label={`${title} class card`}>
  <header>
    <h2>Class card</h2>
    <span class="badge" style="border-color:var(--warn);color:var(--warn)" title="Provided by the site owner from in-game screenshots; not on the original wiki">Added data · from in-game screenshot</span>
  </header>
  <p class="cc-desc">{card.desc}</p>
  <div class="cc-grid">
    <div>
      <h3>Key stats</h3>
      <div class="cc-chips">{card.stats.map(s => <span class="chip-static">{s}</span>)}</div>
    </div>
    <div>
      <h3>Always on</h3>
      <ul class="cc-on">{card.on.map(s => <li class={neg(s) ? 'neg' : 'pos'}>{s}</li>)}</ul>
    </div>
    <div>
      <h3>Equipment</h3>
      <div class="cc-chips">
        {card.weapons.map(s => <span class="chip-static weapon">{s}</span>)}
        {card.armor.map(s => <span class="chip-static armor">{s}</span>)}
        {card.weapons.length + card.armor.length === 0 && <span class="faint">Not shown on the card</span>}
      </div>
      <p class="faint cc-small">Weapon styles in green, armor types in blue. {card.rule}</p>
    </div>
    <div>
      <h3>Skill trees</h3>
      <div class="cc-chips">{card.trees.map(s => <span class="chip-static">{s}</span>)}</div>
    </div>
  </div>
  <div class="cc-unlock">
    <h3>How to unlock</h3>
    <p>{card.unlock}</p>
    <p class="faint cc-small">Community-reported (Discord), not verified by the original wiki. Rules may change with game updates.</p>
  </div>
</section>
