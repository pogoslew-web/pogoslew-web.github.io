---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { categories, entities, FAMILIES, FAMILY_BLURB, asset, byPath } from '../lib/db';
const groups = FAMILIES.map(f => ({ f, cats: categories.filter(c => c.family === f) })).filter(g => g.cats.length);
const sample = (c: any) => { for (const p of c.order) { const e = byPath.get(p); const a = e && asset(e.image); if (a) return a; } return null; };
const total = entities.length;
---
<Base title="Database" description="Every Overrank category in one place: gameplay, progression, items, world, guides and extras.">
  <div class="wrap page">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Database' }]} />
    <header class="page-head"><h1>Database <span class="count">{total} pages · {categories.length} categories</span></h1><p>Every category of the original wiki, grouped by what you want to do.</p></header>
    {groups.map(g => (
      <section style="margin-bottom:40px">
        <div class="section-title" style="margin-top:0"><div><div class="eyebrow">{g.f}</div><h2>{FAMILY_BLURB[g.f]}</h2></div></div>
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(250px,1fr))">
          {g.cats.map(c => { const im = sample(c); return (
            <a class="card card-link" href={`/${c.id}/`} style="overflow:hidden;display:flex;flex-direction:column">
              <span class="entry-media" style="aspect-ratio:16/7">{im ? <img src={im} alt="" loading="lazy" width="320" height="140" /> : <Icon name={c.id} size={32} />}</span>
              <span class="entry-body"><span class="entry-title" style="display:flex;justify-content:space-between;gap:8px"><span>{c.label}</span><span class="faint" style="font-weight:500;font-size:var(--fs-sm)">{c.count}</span></span>
              <span class="muted" style="font-size:var(--fs-sm)">{c.description}</span></span>
            </a>); })}
        </div>
      </section>
    ))}
  </div>
</Base>
