---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => <li>{it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label })) })} />
