---
import { categories, entities } from '../lib/db';
const n = entities.length;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h2>Overrank Atlas</h2>
        <p>An independent, redesigned reading experience for the public Overrank wiki. {n} pages, every value kept as published at the source.</p>
        <p>Not affiliated with AwaitLab. Game content, names and artwork belong to their owners (“Overrank art © AwaitLab” at the source). Images are shown for private review and must not be published without authorization.</p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/database/">All categories</a></li><li><a href="/codes/">Codes</a></li><li><a href="/news/">Announcements</a></li><li><a href="/search/">Search</a></li><li><a href="/random/">Random page</a></li>
        </ul>
      </div>
      <div>
        <h2>Data</h2>
        <ul>
          <li><a href="/integrity/">Content integrity report</a></li>
          <li><a href="https://overrank.awaitlab.com/en/w/overrank" target="_blank" rel="noopener noreferrer">Original wiki ↗</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
