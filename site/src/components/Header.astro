---
import Icon from './Icon.astro';
import { categories, FAMILIES, FAMILY_BLURB, asset } from '../lib/db';
const icon = asset('/games/overrank/icon.webp');
const groups = FAMILIES.map(f => ({ f, cats: categories.filter(c => c.family === f) })).filter(g => g.cats.length);
const extraLinks = [{ href: '/codes/', label: 'Codes', n: '' }, { href: '/news/', label: 'Announcements', n: '' }, { href: '/leaderboards/', label: 'Leaderboards', n: '' }];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Overrank Atlas — home">
      {icon && <img src={icon} alt="" width="30" height="30" />}
      <span>Overrank<small>Atlas</small></span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      {groups.map(g => (
        <details data-menu>
          <summary>{g.f}</summary>
          <div class="menu-pop">
            <div class="blurb">{FAMILY_BLURB[g.f]}</div>
            {g.cats.map(c => <a href={`/${c.id}/`}><b>{c.label}</b><span>{c.count}</span></a>)}
            {g.f === 'Extra' && extraLinks.map(l => <a href={l.href}><b>{l.label}</b></a>)}
          </div>
        </details>
      ))}
      <a class="nav-link" href="/codes/">Codes</a>
    </nav>
    <div class="header-actions">
      <button class="search-trigger" type="button" data-open-search aria-label="Search the database">
        <Icon name="search" size={16} /> <span>Search…</span> <span class="kbd">Ctrl K</span>
      </button>
      <button class="btn btn-ghost btn-icon search-icon-btn" type="button" data-open-search aria-label="Search"><Icon name="search" /></button>
      <button class="btn btn-ghost btn-icon" type="button" id="theme-toggle" aria-label="Toggle light / dark theme"><Icon name="sun" /></button>
      <button class="btn btn-ghost btn-icon burger" type="button" id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><Icon name="menu" /></button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer-bg" id="drawer-bg"></div>
  <div class="drawer-panel">
    <div style="display:flex;justify-content:space-between;align-items:center">
      <b style="font-family:var(--font-display);font-size:1.1rem">Browse</b>
      <button class="btn btn-ghost btn-icon" type="button" id="menu-close" aria-label="Close menu"><Icon name="close" /></button>
    </div>
    <button class="btn" type="button" data-open-search style="justify-content:flex-start;min-height:48px"><Icon name="search" size={18} /> Search everything</button>
    <a class="btn btn-primary" href="/codes/" style="min-height:48px">Redeem codes</a>
    {groups.map(g => (
      <details>
        <summary>{g.f}</summary>
        {g.cats.map(c => <a href={`/${c.id}/`}>{c.label}<span>{c.count}</span></a>)}
        {g.f === 'Extra' && extraLinks.map(l => <a href={l.href}>{l.label}</a>)}
      </details>
    ))}
    <a class="btn btn-ghost" href="/database/" style="justify-content:flex-start">All categories</a>
    <a class="btn btn-ghost" href="/integrity/" style="justify-content:flex-start">Content integrity report</a>
  </div>
</div>
<script>
  const d = document.getElementById('drawer')!;
  const open = (v: boolean) => { d.dataset.open = String(v); document.getElementById('menu-open')?.setAttribute('aria-expanded', String(v)); document.body.style.overflow = v ? 'hidden' : ''; };
  document.getElementById('menu-open')?.addEventListener('click', () => open(true));
  document.getElementById('menu-close')?.addEventListener('click', () => open(false));
  document.getElementById('drawer-bg')?.addEventListener('click', () => open(false));
  document.querySelectorAll('#drawer a').forEach(a => a.addEventListener('click', () => open(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { open(false); document.querySelectorAll<HTMLDetailsElement>('[data-menu][open]').forEach(x => (x.open = false)); } });
  // un seul menu déroulant ouvert à la fois, fermeture au clic extérieur
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-menu]')];
  menus.forEach(m => m.addEventListener('toggle', () => { if (m.open) menus.forEach(o => o !== m && (o.open = false)); }));
  document.addEventListener('click', e => { if (!(e.target as HTMLElement).closest('[data-menu]')) menus.forEach(m => (m.open = false)); });
  // thème
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {}
  });
</script>
